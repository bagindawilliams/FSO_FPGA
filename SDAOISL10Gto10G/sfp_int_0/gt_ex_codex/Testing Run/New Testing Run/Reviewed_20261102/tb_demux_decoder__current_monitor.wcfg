<?xml version='1.0' encoding='UTF-8'?>
<wave_config>
  <wave_state />
  <zoom_setting />
  <column_width_setting />
  <WVObjectSize size="6" />
  <wvobject type="group" fp_name="group0">
    <obj_property name="label">System Clock / Control</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="logic" fp_name="/tb_demux_decoder/clk">
      <obj_property name="ObjectShortName">clk</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
    <wvobject type="logic" fp_name="/tb_demux_decoder/rst_n">
      <obj_property name="ObjectShortName">rst_n</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
  </wvobject>
  <wvobject type="group" fp_name="group1">
    <obj_property name="label">Data Input / valid-only 128-bit slots</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="logic" fp_name="/tb_demux_decoder/cdc_valid_in">
      <obj_property name="ObjectShortName">cdc_valid_in</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/cdc_data_in">
      <obj_property name="ObjectShortName">cdc_data_in</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/input_accepted_beats">
      <obj_property name="ObjectShortName">input_accepted_beats</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/input_accepted_bytes">
      <obj_property name="ObjectShortName">input_accepted_bytes</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/first_input_ns">
      <obj_property name="ObjectShortName">first_input_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/last_input_ns">
      <obj_property name="ObjectShortName">last_input_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
  </wvobject>
  <wvobject type="group" fp_name="group2">
    <obj_property name="label">Preamble extraction / TB scenario identity</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="logic" fp_name="/tb_demux_decoder/preamble_valid">
      <obj_property name="ObjectShortName">preamble_valid</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/preamble_extracted">
      <obj_property name="ObjectShortName">preamble_extracted</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
    </wvobject>
    <wvobject type="logic" fp_name="/tb_demux_decoder/link_locked">
      <obj_property name="ObjectShortName">link_locked</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/locked_frame_cnt">
      <obj_property name="ObjectShortName">locked_frame_cnt</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/demux_frame_id">
      <obj_property name="ObjectShortName">demux_frame_id</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/frame_type_str">
      <obj_property name="ObjectShortName">frame_type_str</obj_property>
      <obj_property name="Radix">ASCIIRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/preamble_event_ns">
      <obj_property name="ObjectShortName">preamble_event_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/measured_preamble_interval_ns">
      <obj_property name="ObjectShortName">measured_preamble_interval_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
  </wvobject>
  <wvobject type="group" fp_name="group3">
    <obj_property name="label">Data Output / LPC coded 96-bit words</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="logic" fp_name="/tb_demux_decoder/lpc_valid_out">
      <obj_property name="ObjectShortName">lpc_valid_out</obj_property>
      <obj_property name="Radix">BINRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/lpc_data_out">
      <obj_property name="ObjectShortName">lpc_data_out</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/frame_words">
      <obj_property name="ObjectShortName">frame_words</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/out_byte_cnt">
      <obj_property name="ObjectShortName">out_byte_cnt</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/output_accepted_beats">
      <obj_property name="ObjectShortName">output_accepted_beats</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/output_accepted_bytes">
      <obj_property name="ObjectShortName">output_accepted_bytes</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/first_output_ns">
      <obj_property name="ObjectShortName">first_output_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
    <wvobject type="other" fp_name="/tb_demux_decoder/last_output_ns">
      <obj_property name="ObjectShortName">last_output_ns</obj_property>
      <obj_property name="Radix">REALRADIX</obj_property>
    </wvobject>
  </wvobject>
  <wvobject type="group" fp_name="group4">
    <obj_property name="label">Measurement / byte oracle and completion</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="array" fp_name="/tb_demux_decoder/completed_frames">
      <obj_property name="ObjectShortName">completed_frames</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/mismatch_count">
      <obj_property name="ObjectShortName">mismatch_count</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/oracle_index">
      <obj_property name="ObjectShortName">oracle_index</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/expected_octet">
      <obj_property name="ObjectShortName">expected_octet</obj_property>
      <obj_property name="Radix">HEXRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/elapsed_cycles">
      <obj_property name="ObjectShortName">elapsed_cycles</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/input_valid_low_cycles">
      <obj_property name="ObjectShortName">input_valid_low_cycles</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/output_valid_low_cycles">
      <obj_property name="ObjectShortName">output_valid_low_cycles</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
  </wvobject>
  <wvobject type="group" fp_name="group5">
    <obj_property name="label">Historical diagnostics / not transfer identity</obj_property>
    <obj_property name="DisplayName">label</obj_property>
    <wvobject type="array" fp_name="/tb_demux_decoder/legacy_display_frame_id">
      <obj_property name="ObjectShortName">legacy_display_frame_id</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
    </wvobject>
    <wvobject type="array" fp_name="/tb_demux_decoder/in_byte_cnt">
      <obj_property name="ObjectShortName">in_byte_cnt</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
