    <wvobject type="array" fp_name="/tb_demux_decoder/in_clk_cnt">
      <obj_property name="ObjectShortName">in_clk_cnt</obj_property>
      <obj_property name="Radix">UNSIGNEDDECRADIX</obj_property>
