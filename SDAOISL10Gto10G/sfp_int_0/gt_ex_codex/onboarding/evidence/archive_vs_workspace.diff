+    always @(posedge clk or negedge rst_n) begin
+        if (~rst_n)
+            data_in_d0 <= 8'b0;
+        else
+            data_in_d0 <= en ? data_in : 8'b0;
+    end
+
+    integer i;
+    always @(posedge clk or negedge rst_n) begin
+        if (~rst_n) begin
+            for (i = 0; i < 16; i = i + 1)
+                Q[i] <= 8'b0;
+        end else if (state == ACTIVE) begin
+            // [Rev 2.5 - Fix R17] Run full 256-cycle Horner shift (with data_in_d0 = 0 when en == 0)
+            for (i = 0; i < 16; i = i + 1)
