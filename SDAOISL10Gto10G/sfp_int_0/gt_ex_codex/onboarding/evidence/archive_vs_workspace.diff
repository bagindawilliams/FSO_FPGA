+    multiplier gf_1 (8'had, Q[1], D[1]);
+    multiplier gf_2 (8'hbe, Q[2], D[2]);
+    multiplier gf_3 (8'h3a, Q[3], D[3]);
+    multiplier gf_4 (8'h3c, Q[4], D[4]);
