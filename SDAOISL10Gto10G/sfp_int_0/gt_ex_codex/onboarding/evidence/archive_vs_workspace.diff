+      beta^4 (alpha^44) = 8'h3c, beta^5 (alpha^55) = 8'hdc, beta^6 (alpha^66) = 8'h56,
+      beta^7 (alpha^77) = 8'hca, beta^8 (alpha^88) = 8'h42.
