+    // FSM State Register
+    always @(posedge clk or negedge rst_n) begin
+        if (~rst_n)
+            state <= IDLE;
+        else
+            state <= next_state;
+    end
+
+    // Cycle Counter
+    always @(posedge clk or negedge rst_n) begin
+        if (~rst_n)
+            count <= 8'd0;
+        else if (state == ACTIVE)
+            count <= count + 1'b1;
+        else
+            count <= 8'd0;
