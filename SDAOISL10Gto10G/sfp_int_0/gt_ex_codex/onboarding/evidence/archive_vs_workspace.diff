+module syndrome_unit #(
+    parameter max = 255
+)(
+    input  wire         clk,
+    input  wire         rst_n,
+    input  wire         en,
+    input  wire [7:0]   data_in,
+    output wire         flag,
+    output wire [127:0] syndrome
+);
+
+    reg [15:0] count = 16'd0;
+
+    reg  [7:0] Q [0:15];
+    wire [7:0] D [0:15];
+    wire [7:0] C [0:15];
