+					data_cnt <= data_cnt + 1;
+				end
+			end
+			SEND_DATA_END:
+			begin
+				gt_tx_ctrl <= 4'b0000;
+				gt_tx_data <= temp[191:160];
+				check_sum <= check_sum + temp[191:160];
